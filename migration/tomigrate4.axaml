<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:vm="using:MacroCanvas.UI.ViewModels"
             xmlns:models="using:MacroCanvas.Core.Models"
             xmlns:conv="using:MacroCanvas.UI.Converters"
             xmlns:controls="using:MacroCanvas.UI.Controls"
             xmlns:interactions="using:MacroCanvas.UI.Interactions"
             x:Class="MacroCanvas.UI.Controls.FileExplorerControl"
             x:DataType="vm:FileExplorerViewModel">

  <!-- ── Keyboard shortcuts (Interaction Kit): ALL of them live here, including the
       hover-scoped ones. Hover-awareness is a command concern (DeleteHovered /
       BeginRenameHovered consult HoveredItem), not a key-routing concern. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+C"       Command="{Binding CopyCommand}"/>
    <KeyBinding Gesture="Ctrl+X"       Command="{Binding CutCommand}"/>
    <KeyBinding Gesture="Ctrl+V"       Command="{Binding PasteCommand}"/>
    <KeyBinding Gesture="Delete"       Command="{Binding DeleteHoveredCommand}"/>
    <KeyBinding Gesture="F2"           Command="{Binding BeginRenameHoveredCommand}"/>
    <KeyBinding Gesture="F5"           Command="{Binding RefreshDirectoryCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding BeginCreateFolderCommand}"
                CommandParameter="{Binding ContextItem}"/>
    <KeyBinding Gesture="Escape"       Command="{Binding CancelEditsCommand}"/>
    <KeyBinding Gesture="Enter"        Command="{Binding ConfirmOrOpenCommand}"/>
  </UserControl.KeyBindings>

  <UserControl.Styles>

    <Style Selector="Button.toolBtn">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="7,4"/>
      <Setter Property="CornerRadius"    Value="5"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="FontSize"        Value="13"/>
    </Style>
    <Style Selector="Button.toolBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}"/>
    </Style>
    <Style Selector="Button.toolBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeBg3Brush}"/>
    </Style>

    <Style Selector="Button.browseBtn">
      <Setter Property="Background"        Value="{DynamicResource ThemeBg3Brush}"/>
      <Setter Property="BorderThickness"   Value="0"/>
      <Setter Property="Padding"           Value="8,4"/>
      <Setter Property="CornerRadius"      Value="5"/>
      <Setter Property="Cursor"            Value="Hand"/>
      <Setter Property="FontSize"          Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.browseBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}"/>
    </Style>

    <Style Selector="TextBox.pathBox">
      <Setter Property="FontSize"          Value="11"/>
      <Setter Property="Height"            Value="24"/>
      <Setter Property="Padding"           Value="6,2"/>
      <Setter Property="CornerRadius"      Value="4"/>
      <Setter Property="Background"        Value="{DynamicResource ThemeBg0Brush}"/>
      <Setter Property="BorderBrush"       Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness"   Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.pathBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}"/>
    </Style>

    <Style Selector="TextBox.inlineInput">
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Height"          Value="24"/>
      <Setter Property="Padding"         Value="4,2"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="Background"      Value="{DynamicResource ThemeBg0Brush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource AccentForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.renameBox">
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Height"          Value="22"/>
      <Setter Property="Padding"         Value="3,1"/>
      <Setter Property="CornerRadius"    Value="3"/>
      <Setter Property="Background"      Value="{DynamicResource ThemeBg0Brush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource AccentForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinWidth"        Value="80"/>
    </Style>

    <Style Selector="Button.confirmBtn">
      <Setter Property="Background"      Value="{DynamicResource ThemeBg3Brush}"/>
      <Setter Property="Foreground"      Value="#4caf50"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="6,3"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="FontWeight"      Value="Bold"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.cancelBtn">
      <Setter Property="Background"      Value="{DynamicResource ThemeBg3Brush}"/>
      <Setter Property="Foreground"      Value="#f44336"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="6,3"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="FontWeight"      Value="Bold"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <!-- ── File row ──────────────────────────────────────────────────────
         Selection highlight is driven by the .selected class (Classes.selected
         bound to IsSelected). The drop highlight is now the .drop-ok class,
         toggled by DropTargetBehavior when a valid payload is over the row
         (replacing the old code-behind .dragOver tracking).

         BorderThickness is reserved (transparent) in the base style so the
         drop state only recolors it — adding thickness on the fly shifted rows.
         ───────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.fileRow">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderBrush"     Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="5"/>
      <Setter Property="Padding"         Value="6,0"/>
      <Setter Property="Margin"          Value="2,1"/>
      <Setter Property="MinHeight"       Value="26"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Border.fileRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}"/>
    </Style>
    <Style Selector="Border.fileRow.selected">
      <Setter Property="Background" Value="#220066CC"/>
    </Style>
    <Style Selector="Border.fileRow.selected:pointerover">
      <Setter Property="Background" Value="#330066CC"/>
    </Style>
    <Style Selector="Border.fileRow.drop-ok">
      <Setter Property="Background"  Value="{DynamicResource ThemeBg3Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}"/>
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- ── Path bar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{DynamicResource ThemeBg1Brush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="6,5">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="📁" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,5,0"/>
        <!-- OneWay: commit happens via Enter in code-behind reading tb.Text. -->
        <TextBox Grid.Column="1" x:Name="PathBox"
                 Text="{Binding CurrentRootPath, Mode=OneWay}"
                 Classes="pathBox"
                 ToolTip.Tip="Type a path and press Enter, or click Browse"
                 KeyDown="OnPathBoxKeyDown"/>
        <Button Grid.Column="2" Content="Browse…" Classes="browseBtn"
                Margin="5,0,0,0" Click="OnBrowseClick"
                ToolTip.Tip="Choose a folder"/>
      </Grid>
    </Border>

    <!-- ── Toolbar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="1"
            Background="{DynamicResource ThemeBg2Brush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="4,3"
            IsEnabled="{Binding HasDirectory}">
      <!-- VSCode-style explorer toolbar: New File · New Folder · Refresh · Collapse All.
           Copy/Cut/Paste/Rename/Delete now live on the right-click menu and the
           keyboard shortcuts (Ctrl+C/X/V, F2, Del) — keeps this row clean. -->
      <WrapPanel Orientation="Horizontal">

        <!-- New File — ContextItem so it lands in the selected folder (null = root) -->
        <Button Command="{Binding BeginCreateFileCommand}"
                CommandParameter="{Binding ContextItem}"
                ToolTip.Tip="New File"
                Classes="toolBtn">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Text="📄" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="+" FontWeight="Bold" FontSize="11"
                       Foreground="{DynamicResource AccentForegroundBrush}"
                       VerticalAlignment="Top" Margin="0,-2,0,0"/>
          </StackPanel>
        </Button>

        <!-- New Folder -->
        <Button Command="{Binding BeginCreateFolderCommand}"
                CommandParameter="{Binding ContextItem}"
                ToolTip.Tip="New Folder  Ctrl+Shift+N"
                Classes="toolBtn">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Text="📁" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="+" FontWeight="Bold" FontSize="11"
                       Foreground="#4caf50" VerticalAlignment="Top" Margin="0,-2,0,0"/>
          </StackPanel>
        </Button>

        <!-- Refresh (moved here from the path bar) -->
        <Button Command="{Binding RefreshDirectoryCommand}"
                ToolTip.Tip="Refresh  F5" Classes="toolBtn">
          <TextBlock Text="↻" FontSize="15" Foreground="{DynamicResource ThemeFg1Brush}"/>
        </Button>

        <!-- Collapse All — no parameter ⇒ collapses the whole tree -->
        <Button Command="{Binding CollapseAllCommand}"
                ToolTip.Tip="Collapse All" Classes="toolBtn">
          <TextBlock Text="⊟" FontSize="14" Foreground="{DynamicResource ThemeFg1Brush}"/>
        </Button>

      </WrapPanel>
    </Border>

    <!-- ── Inline create bar ──────────────────────────────────────────── -->
    <Border Grid.Row="2"
            Background="{DynamicResource ThemeBg2Brush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,0,0,1" Padding="8,5">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsCreatingFolder"/>
          <Binding Path="IsCreatingFile"/>
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="📁" FontSize="13" VerticalAlignment="Center"
                   IsVisible="{Binding IsCreatingFolder}"/>
        <TextBlock Text="📄" FontSize="13" VerticalAlignment="Center"
                   IsVisible="{Binding IsCreatingFile}"/>
        <TextBlock Text="Folder name:" FontSize="12"
                   Foreground="{DynamicResource ThemeFg2Brush}" VerticalAlignment="Center"
                   IsVisible="{Binding IsCreatingFolder}"/>
        <TextBlock Text="File name:" FontSize="12"
                   Foreground="{DynamicResource ThemeFg2Brush}" VerticalAlignment="Center"
                   IsVisible="{Binding IsCreatingFile}"/>
        <TextBox Text="{Binding NewItemName}" Width="180" Classes="inlineInput"/>
        <Button Command="{Binding ConfirmCreateCommand}" Classes="confirmBtn" Content="✓"/>
        <Button Command="{Binding CancelCreateCommand}"  Classes="cancelBtn"  Content="✕"/>
      </StackPanel>
    </Border>

    <!-- ── Tree view ─────────────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto"
                  PointerPressed="OnScrollViewerPressed">
      <TreeView x:Name="FileExplorerTree"
                ItemsSource="{Binding RootItems}"
                Background="Transparent"
                BorderThickness="0"
                Focusable="True"
                FontSize="{Binding Zoom}"
                Padding="4,4">

        <!-- Tree-level interactions: wheel routing (Ctrl=zoom, Shift=step selection)
             and a root drop zone for drops onto empty space. -->
        <i:Interaction.Interactions>
          <interactions:WheelRouterBehavior CtrlWheelCommand="{Binding ApplyZoomCommand}"
                                         ShiftWheelCommand="{Binding StepSelectionCommand}"/>
          <interactions:FileExplorerDropTargetBehavior
              DropCommand="{Binding DropCommand}"
              TargetContext="{x:Null}"
              AutoExpand="False"/>
        </i:Interaction.Interactions>

        <TreeView.Styles>
          <!-- Strip the default Avalonia selection box; highlight is owned by
               Border.fileRow.selected. -->
          <!-- x:CompileBindings="False": the IsExpanded setter binds the TreeViewItem's
               own DataContext (a FileExplorerItem), but the ambient x:DataType in this
               file is the VM — so it must resolve at runtime, not compile-time. -->
          <Style Selector="TreeViewItem" x:CompileBindings="False">
            <!-- Two-way IsExpanded: Expand/Collapse All set the model and it reflects in
                 the view; user chevron toggles flow back. Replaces the old code-behind
                 container sync, which set IsExpanded as a local value and would have
                 blocked programmatic collapse. -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="0"/>
          </Style>
          <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin"       Value="2,1"/>
          </Style>
          <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
        </TreeView.Styles>

        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="models:FileExplorerItem"
                            ItemsSource="{Binding Children}">

            <Border Classes="fileRow"
                    Classes.selected="{Binding IsSelected}"
                    Opacity="{Binding IsCut, Converter={x:Static conv:BoolToOpacityConverter.Instance}}"
                    ToolTip.Tip="{Binding Tooltip}"
                    DoubleTapped="OnRowDoubleTapped">

              <!-- Interaction Kit: hover tracking, drag source (payload = FullPath),
                   and a per-row drop target (this item is the destination folder). -->
              <i:Interaction.Interactions>
                <interactions:HoverTrackerBehavior
                    Item="{Binding}"
                    Tracker="{Binding $parent[controls:FileExplorerControl].((vm:FileExplorerViewModel)DataContext)}"/>
                <interactions:DragSourceBehavior Payload="{Binding FullPath}"/>
                <interactions:FileExplorerDropTargetBehavior
                    DropCommand="{Binding $parent[controls:FileExplorerControl].((vm:FileExplorerViewModel)DataContext).DropCommand}"
                    TargetContext="{Binding}"/>
              </i:Interaction.Interactions>

              <Border.ContextMenu>
                <ContextMenu x:CompileBindings="False">
                  <MenuItem Header="↗  Open"
                            Command="{Binding $parent[UserControl].DataContext.OpenCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="📁  New Folder here"
                            Command="{Binding $parent[UserControl].DataContext.BeginCreateFolderCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="📄  New File here"
                            Command="{Binding $parent[UserControl].DataContext.BeginCreateFileCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="✏️  Rename    F2"
                            Command="{Binding $parent[UserControl].DataContext.BeginRenameCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="⎘  Copy      Ctrl+C"
                            Command="{Binding $parent[UserControl].DataContext.CopyCommand}"/>
                  <MenuItem Header="✂  Cut       Ctrl+X"
                            Command="{Binding $parent[UserControl].DataContext.CutCommand}"/>
                  <MenuItem Header="📋  Paste     Ctrl+V"
                            Command="{Binding $parent[UserControl].DataContext.PasteCommand}"/>
                  <Separator/>
                  <MenuItem Header="▶  Expand All"
                            IsVisible="{Binding IsDirectory}"
                            Command="{Binding $parent[UserControl].DataContext.ExpandAllCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="◀  Collapse All"
                            IsVisible="{Binding IsDirectory}"
                            Command="{Binding $parent[UserControl].DataContext.CollapseAllCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="🗑  Delete    Del"
                            Command="{Binding $parent[UserControl].DataContext.DeleteItemCommand}"
                            CommandParameter="{Binding}"
                            Foreground="#f44336"/>
                </ContextMenu>
              </Border.ContextMenu>

              <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="26">
                <!-- Icon column — off by default (VSCode style). Gated by
                     PanelOptions.ShowIcons; when off, nothing computes a glyph. -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Icon}"
                           IsVisible="{Binding $parent[controls:FileExplorerControl].PanelOptions.ShowIcons}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"
                           IsHitTestVisible="False"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           IsVisible="{Binding IsBeingEdited, Converter={x:Static BoolConverters.Not}}"
                           Foreground="{DynamicResource ThemeFg0Brush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>

                <TextBox Grid.Column="1"
                         x:CompileBindings="False"
                         Text="{Binding $parent[UserControl].DataContext.RenameText}"
                         IsVisible="{Binding IsBeingEdited}"
                         Classes="renameBox"
                         VerticalAlignment="Center"/>

                <!-- File size column — gated by PanelOptions.ShowFileSize. -->
                <TextBlock Grid.Column="2"
                           Text="{Binding FormattedSize}"
                           IsVisible="{Binding $parent[controls:FileExplorerControl].PanelOptions.ShowFileSize}"
                           FontSize="11"
                           Foreground="{DynamicResource ThemeFg2Brush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
              </Grid>
            </Border>

          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </ScrollViewer>

    <!-- ── Status bar ────────────────────────────────────────────────── -->
    <Border Grid.Row="4"
            Background="{DynamicResource ThemeBg2Brush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,4">
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="11"
                 Foreground="{DynamicResource ThemeFg2Brush}"
                 TextTrimming="CharacterEllipsis"/>
    </Border>

  </Grid>
</UserControl>