<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:fonts="clr-namespace:OTCode.Core.Enums;assembly=OTCode.Core"
             xmlns:domains="clr-namespace:OTCode.Core.Domains.FileExplorer;assembly=OTCode.Core"
             xmlns:controls="clr-namespace:OTCode.UI.Controls"
             xmlns:behaviors="clr-namespace:OTCode.UI.Behaviors"
             xmlns:behaviorsfileexplorer="clr-namespace:OTCode.UI.Behaviors.FileExplorer"
             xmlns:conv="clr-namespace:OTCode.UI.Converters"
             x:Class="OTCode.UI.Controls.FileExplorerControl"
             FontFamily="{DynamicResource {x:Static fonts:AppFont.SegoeUIVariable}}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  KEYBOARD COMMANDS                                          -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Hover-sensitive commands resolve their target in the view model. -->
  <UserControl.InputBindings>

    <KeyBinding Key="C"
                Modifiers="Control"
                Command="{Binding CopyCommand}" />

    <KeyBinding Key="X"
                Modifiers="Control"
                Command="{Binding CutCommand}" />

    <KeyBinding Key="V"
                Modifiers="Control"
                Command="{Binding PasteCommand}" />

    <KeyBinding Key="Delete"
                Command="{Binding DeleteHoveredCommand}" />

    <KeyBinding Key="F2"
                Command="{Binding BeginRenameHoveredCommand}" />

    <KeyBinding Key="F5"
                Command="{Binding RefreshDirectoryCommand}" />

    <KeyBinding Key="N"
                Modifiers="Control+Shift"
                Command="{Binding BeginCreateFolderCommand}"
                CommandParameter="{Binding ContextItem}" />

    <KeyBinding Key="Escape"
                Command="{Binding CancelEditsCommand}" />

    <KeyBinding Key="Return"
                Command="{Binding ConfirmOrOpenCommand}" />

  </UserControl.InputBindings>
  <UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  ICON MASKS                                                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <ImageBrush x:Key="MaskFolder"
                ImageSource="/OTCode.UI;component/Assets/Icons/folder.png"
                Stretch="Uniform" />

    <ImageBrush x:Key="MaskNewFile"
                ImageSource="/OTCode.UI;component/Assets/Icons/new-file.png"
                Stretch="Uniform" />

    <ImageBrush x:Key="MaskNewFolder"
                ImageSource="/OTCode.UI;component/Assets/Icons/new-folder.png"
                Stretch="Uniform" />

    <ImageBrush x:Key="MaskRefresh"
                ImageSource="/OTCode.UI;component/Assets/Icons/refresh.png"
                Stretch="Uniform" />

    <ImageBrush x:Key="MaskCollapse"
                ImageSource="/OTCode.UI;component/Assets/Icons/collapse.png"
                Stretch="Uniform" />

    <ImageBrush x:Key="MaskCheck"
                ImageSource="/OTCode.UI;component/Assets/Icons/check.png"
                Stretch="Uniform" />

    <ImageBrush x:Key="MaskClose"
                ImageSource="/OTCode.UI;component/Assets/Icons/close.png"
                Stretch="Uniform" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  LOCAL BUTTON VARIANTS                                      -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Shared templates supply hover, pressed, disabled and focus states. -->
    <Style x:Key="FileExplorerToolButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ThemedButtonStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="FileExplorerBrowseButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ThemedButtonStyle}">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="FileExplorerConfirmButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="FileExplorerCancelButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource ThemedButtonStyle}">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  LOCAL MENU VARIANTS                                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- ContextMenu is a Popup and establishes typography explicitly. -->
    <Style x:Key="FileExplorerContextMenuStyle"
           TargetType="{x:Type ContextMenu}"
           BasedOn="{StaticResource {x:Type ContextMenu}}">
      <Setter Property="FontFamily"
              Value="{DynamicResource {x:Static fonts:AppFont.SegoeUIVariable}}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="FileExplorerDangerMenuItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Foreground"
              Value="{DynamicResource ThemeErrorBrush}" />
    </Style>

    <Style x:Key="FileExplorerMenuSeparatorStyle"
           TargetType="{x:Type Separator}">
      <Setter Property="Margin" Value="4,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1"
                    Background="{DynamicResource ThemeBorderBrush}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  LOCAL INPUT VARIANTS                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="FileExplorerPathBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource mono}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FileExplorerInlineInputStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource DefaultTextBoxStyle}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FileExplorerRenameBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource FileExplorerInlineInputStyle}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  FILE-TREE TYPOGRAPHY                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style x:Key="FileExplorerNameTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource DefaultTextBlockStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FileExplorerMetadataTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource caption}">
      <Setter Property="FontFamily"
              Value="{DynamicResource {x:Static fonts:AppFont.CascadiaMono}}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  FILE ROW                                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    
    <Style x:Key="FileExplorerRowStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource AppSurfaceStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />

      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background"
                  Value="{DynamicResource ThemeHoverBrush}" />
        </Trigger>

        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background"
                  Value="{DynamicResource AccentSubtleBrush}" />
          <Setter Property="BorderBrush"
                  Value="{DynamicResource AccentBrush}" />
        </DataTrigger>

        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelected}" Value="True" />
            <Condition Binding="{Binding IsMouseOver,
                                         RelativeSource={RelativeSource Self}}"
                       Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background"
                  Value="{DynamicResource AccentSubtleBrush}" />
          <Setter Property="BorderBrush"
                  Value="{DynamicResource AccentHoverBrush}" />
        </MultiDataTrigger>

        <DataTrigger Binding="{Binding (behaviorsfileexplorer:FileExplorerDropTargetBehavior.IsDropOk),
                                       RelativeSource={RelativeSource Self}}"
                     Value="True">
          <Setter Property="Background"
                  Value="{DynamicResource ThemeSelectedBrush}" />
          <Setter Property="BorderBrush"
                  Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FileExplorerTreeItemStyle"
           TargetType="{x:Type TreeViewItem}"
           BasedOn="{StaticResource InheritedForegroundControlStyle}">
      <Setter Property="IsExpanded"
              Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
    </Style>

  </UserControl.Resources>

  <!-- Establish the neutral surface/foreground pair once for the control. -->
  <Border Style="{StaticResource AppSurfaceStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!--  PATH BAR                                                -->
      <!-- ═════════════════════════════════════════════════════════ -->

      <Border Grid.Row="0"
              Style="{StaticResource PanelSurfaceStyle}"
              BorderThickness="0,0,0,1"
              CornerRadius="0"
              Padding="8,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Rectangle Grid.Column="0"
                     Width="15"
                     Height="15"
                     Fill="{DynamicResource ThemeFg1Brush}"
                     OpacityMask="{StaticResource MaskFolder}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />

          <!-- OneWay: Enter commits the current text in code-behind. -->
          <TextBox Grid.Column="1"
                   x:Name="PathBox"
                   Style="{StaticResource FileExplorerPathBoxStyle}"
                   Text="{Binding CurrentRootPath, Mode=OneWay}"
                   ToolTip="Type a path and press Enter"
                   KeyDown="OnPathBoxKeyDown" />

          <Button Grid.Column="2"
                  Style="{StaticResource FileExplorerBrowseButtonStyle}"
                  Content="Browse…"
                  Margin="6,0,0,0"
                  ToolTip="Choose a folder"
                  Click="OnBrowseClick" />
        </Grid>
      </Border>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!--  TOOLBAR                                                 -->
      <!-- ═════════════════════════════════════════════════════════ -->

      <Border Grid.Row="1"
              Style="{StaticResource SubtleSurfaceStyle}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="5,4"
              IsEnabled="{Binding HasDirectory}">
        <WrapPanel Orientation="Horizontal">

          <Button Style="{StaticResource FileExplorerToolButtonStyle}"
                  Command="{Binding BeginCreateFileCommand}"
                  CommandParameter="{Binding ContextItem}"
                  ToolTip="New file">
            <Rectangle Width="15"
                       Height="15"
                       Fill="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       OpacityMask="{StaticResource MaskNewFile}"
                       IsHitTestVisible="False" />
          </Button>

          <Button Style="{StaticResource FileExplorerToolButtonStyle}"
                  Command="{Binding BeginCreateFolderCommand}"
                  CommandParameter="{Binding ContextItem}"
                  ToolTip="New folder (Ctrl+Shift+N)">
            <Rectangle Width="15"
                       Height="15"
                       Fill="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       OpacityMask="{StaticResource MaskNewFolder}"
                       IsHitTestVisible="False" />
          </Button>

          <Button Style="{StaticResource FileExplorerToolButtonStyle}"
                  Command="{Binding RefreshDirectoryCommand}"
                  ToolTip="Refresh (F5)">
            <Rectangle Width="15"
                       Height="15"
                       Fill="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       OpacityMask="{StaticResource MaskRefresh}"
                       IsHitTestVisible="False" />
          </Button>

          <Button Style="{StaticResource FileExplorerToolButtonStyle}"
                  Command="{Binding CollapseAllCommand}"
                  ToolTip="Collapse all folders">
            <Rectangle Width="15"
                       Height="15"
                       Fill="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       OpacityMask="{StaticResource MaskCollapse}"
                       IsHitTestVisible="False" />
          </Button>

        </WrapPanel>
      </Border>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!--  INLINE CREATE BAR                                       -->
      <!-- ═════════════════════════════════════════════════════════ -->

      <Border Grid.Row="2"
              Style="{StaticResource SubtleSurfaceStyle}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="8,6"
              Visibility="{Binding IsCreating,
                                   Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

          <TextBlock Style="{StaticResource subtle}"
                     Text="Folder name"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsCreatingFolder,
                                          Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Style="{StaticResource subtle}"
                     Text="File name"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsCreatingFile,
                                          Converter={StaticResource BoolToVisibility}}" />

          <TextBox Style="{StaticResource FileExplorerInlineInputStyle}"
                   Width="200"
                   Margin="0,0,8,0"
                   Text="{Binding NewItemName,
                                  UpdateSourceTrigger=PropertyChanged}" />

          <Button Style="{StaticResource FileExplorerConfirmButtonStyle}"
                  Command="{Binding ConfirmCreateCommand}"
                  Margin="0,0,6,0"
                  ToolTip="Create">
            <Rectangle Width="12"
                       Height="12"
                       Fill="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       OpacityMask="{StaticResource MaskCheck}"
                       IsHitTestVisible="False" />
          </Button>

          <Button Style="{StaticResource FileExplorerCancelButtonStyle}"
                  Command="{Binding CancelCreateCommand}"
                  ToolTip="Cancel">
            <Rectangle Width="12"
                       Height="12"
                       Fill="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       OpacityMask="{StaticResource MaskClose}"
                       IsHitTestVisible="False" />
          </Button>

        </StackPanel>
      </Border>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!--  FILE TREE                                               -->
      <!-- ═════════════════════════════════════════════════════════ -->

      <TreeView Grid.Row="3"
                x:Name="ExplorerTree"
                ItemsSource="{Binding RootItems}"
                ItemContainerStyle="{StaticResource FileExplorerTreeItemStyle}"
                Background="Transparent"
                BorderThickness="0"
                Focusable="True"
                FontSize="{Binding Zoom}"
                Padding="5"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingStackPanel.IsVirtualizing="True"
                PreviewMouseDown="OnTreePreviewMouseDown"
                PreviewMouseLeftButtonUp="OnTreePreviewMouseLeftButtonUp">

        <i:Interaction.Behaviors>
          <behaviors:WheelRouterBehavior
              CtrlWheelCommand="{Binding ApplyZoomCommand}"
              ShiftWheelCommand="{Binding StepSelectionCommand}" />

          <behaviorsfileexplorer:FileExplorerDropTargetBehavior
              DropCommand="{Binding DropCommand}"
              TargetContext="{x:Null}"
              AutoExpand="False" />
        </i:Interaction.Behaviors>

        <TreeView.Resources>
          <!-- FileExplorerRowStyle owns multi-selection rendering. -->
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                           Color="Transparent" />

          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                           Color="Transparent" />

          <HierarchicalDataTemplate DataType="{x:Type domains:FileExplorerItem}"
                                    ItemsSource="{Binding Children}">

            <Border Style="{StaticResource FileExplorerRowStyle}"
                    Opacity="{Binding IsCut,
                                      Converter={x:Static conv:BoolToOpacityConverter.Instance}}"
                    ToolTip="{Binding Tooltip}"
                    Tag="{Binding DataContext,
                                  RelativeSource={RelativeSource AncestorType={x:Type controls:FileExplorerControl}}}">

              <i:Interaction.Behaviors>
                <behaviors:HoverTrackerBehavior
                    Item="{Binding}"
                    Tracker="{Binding DataContext,
                                      RelativeSource={RelativeSource AncestorType={x:Type controls:FileExplorerControl}}}" />

                <behaviors:DragSourceBehavior Payload="{Binding FullPath}" />

                <behaviorsfileexplorer:FileExplorerDropTargetBehavior
                    DropCommand="{Binding DataContext.DropCommand,
                                          RelativeSource={RelativeSource AncestorType={x:Type controls:FileExplorerControl}}}"
                    TargetContext="{Binding}" />
              </i:Interaction.Behaviors>

              <Border.ContextMenu>
                <!-- Popup bindings reach the row through PlacementTarget. -->
                <ContextMenu Style="{StaticResource FileExplorerContextMenuStyle}">
                  <MenuItem Header="Open"
                            InputGestureText="Enter"
                            Command="{Binding PlacementTarget.Tag.OpenCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <Separator Style="{StaticResource FileExplorerMenuSeparatorStyle}" />

                  <MenuItem Header="New folder here"
                            Command="{Binding PlacementTarget.Tag.BeginCreateFolderCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <MenuItem Header="New file here"
                            Command="{Binding PlacementTarget.Tag.BeginCreateFileCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <Separator Style="{StaticResource FileExplorerMenuSeparatorStyle}" />

                  <MenuItem Header="Rename"
                            InputGestureText="F2"
                            Command="{Binding PlacementTarget.Tag.BeginRenameCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <Separator Style="{StaticResource FileExplorerMenuSeparatorStyle}" />

                  <MenuItem Header="Copy"
                            InputGestureText="Ctrl+C"
                            Command="{Binding PlacementTarget.Tag.CopyCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <MenuItem Header="Cut"
                            InputGestureText="Ctrl+X"
                            Command="{Binding PlacementTarget.Tag.CutCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <MenuItem Header="Paste"
                            InputGestureText="Ctrl+V"
                            Command="{Binding PlacementTarget.Tag.PasteCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <Separator Style="{StaticResource FileExplorerMenuSeparatorStyle}" />

                  <MenuItem Header="Expand all"
                            Visibility="{Binding PlacementTarget.DataContext.IsDirectory,
                                                 RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}},
                                                 Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding PlacementTarget.Tag.ExpandAllCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <MenuItem Header="Collapse all"
                            Visibility="{Binding PlacementTarget.DataContext.IsDirectory,
                                                 RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}},
                                                 Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding PlacementTarget.Tag.CollapseAllCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />

                  <Separator Style="{StaticResource FileExplorerMenuSeparatorStyle}" />

                  <MenuItem Header="Delete"
                            InputGestureText="Del"
                            Style="{StaticResource FileExplorerDangerMenuItemStyle}"
                            Command="{Binding PlacementTarget.Tag.DeleteItemCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                </ContextMenu>
              </Border.ContextMenu>

              <Grid MinHeight="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- FileIcons selects a PNG mask; AccentBrush supplies its color. -->
                <Rectangle Grid.Column="0"
                           Width="16"
                           Height="16"
                           Fill="{DynamicResource AccentBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding PanelOptions.ShowIcons,
                                                RelativeSource={RelativeSource AncestorType={x:Type controls:FileExplorerControl}},
                                                Converter={StaticResource BoolToVisibility}}">
                  <Rectangle.OpacityMask>
                    <MultiBinding Converter="{x:Static conv:FileIconConverter.Instance}">
                      <Binding Path="Name" />
                      <Binding Path="Extension" />
                      <Binding Path="IsDirectory" />
                      <Binding Path="IsExpanded" />
                    </MultiBinding>
                  </Rectangle.OpacityMask>
                </Rectangle>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource FileExplorerNameTextStyle}"
                           Text="{Binding Name}"
                           Visibility="{Binding IsBeingEdited,
                                                Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

                <TextBox Grid.Column="1"
                         Style="{StaticResource FileExplorerRenameBoxStyle}"
                         VerticalAlignment="Center"
                         Text="{Binding DataContext.RenameText,
                                        RelativeSource={RelativeSource AncestorType={x:Type controls:FileExplorerControl}},
                                        UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsBeingEdited,
                                              Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource FileExplorerMetadataTextStyle}"
                           Text="{Binding FormattedSize}"
                           Margin="12,0,0,0"
                           Visibility="{Binding PanelOptions.ShowFileSize,
                                                RelativeSource={RelativeSource AncestorType={x:Type controls:FileExplorerControl}},
                                                Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
      </TreeView>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!--  STATUS BAR                                              -->
      <!-- ═════════════════════════════════════════════════════════ -->

      <!-- StatusBar styles are implicit in Surfaces.xaml. -->
      <StatusBar Grid.Row="4"
                 HorizontalContentAlignment="Stretch">
        <StatusBarItem HorizontalContentAlignment="Stretch">
          <TextBlock Style="{StaticResource statusText}"
                     Text="{Binding StatusMessage}" />
        </StatusBarItem>
      </StatusBar>

    </Grid>
  </Border>
</UserControl>