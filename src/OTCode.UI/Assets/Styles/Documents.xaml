<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fonts="clr-namespace:OTCode.Core.Enums;assembly=OTCode.Core">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  RICH TEXT BOX                                              -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DefaultRichTextBoxStyle"
         TargetType="{x:Type RichTextBox}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="FontFamily"
            Value="{DynamicResource {x:Static fonts:AppFont.SegoeUI}}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="SelectionBrush"
            Value="{DynamicResource ThemeSelectedBrush}" />
    <Setter Property="SelectionTextBrush"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="CaretBrush"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush"
                Value="{DynamicResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type RichTextBox}"
         BasedOn="{StaticResource DefaultRichTextBoxStyle}" />

  <!-- Read-only rich content without input chrome. -->
  <Style x:Key="ReadOnlyRichTextBoxStyle"
         TargetType="{x:Type RichTextBox}"
         BasedOn="{StaticResource DefaultRichTextBoxStyle}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  FLOW DOCUMENT FOUNDATION                                   -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DefaultFlowDocumentStyle"
         TargetType="{x:Type FlowDocument}">
    <Setter Property="FontFamily"
            Value="{DynamicResource {x:Static fonts:AppFont.SegoeUI}}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="PagePadding" Value="24" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="DocumentParagraphStyle"
         TargetType="{x:Type Paragraph}">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  DOCUMENT TYPOGRAPHY                                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DocumentHeading1Style"
         TargetType="{x:Type Paragraph}"
         BasedOn="{StaticResource DocumentParagraphStyle}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="LineHeight" Value="36" />
  </Style>

  <Style x:Key="DocumentHeading2Style"
         TargetType="{x:Type Paragraph}"
         BasedOn="{StaticResource DocumentParagraphStyle}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="Margin" Value="0,12,0,12" />
    <Setter Property="LineHeight" Value="30" />
  </Style>

  <Style x:Key="DocumentHeading3Style"
         TargetType="{x:Type Paragraph}"
         BasedOn="{StaticResource DocumentParagraphStyle}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg1Brush}" />
    <Setter Property="Margin" Value="0,8,0,8" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <Style x:Key="DocumentCodeBlockStyle"
         TargetType="{x:Type Paragraph}"
         BasedOn="{StaticResource DocumentParagraphStyle}">
    <Setter Property="FontFamily"
            Value="{DynamicResource {x:Static fonts:AppFont.CascadiaCode}}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Margin" Value="0,4,0,12" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="DocumentQuoteStyle"
         TargetType="{x:Type Paragraph}"
         BasedOn="{StaticResource DocumentParagraphStyle}">
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg1Brush}" />
    <Setter Property="Margin" Value="0,4,0,12" />
    <Setter Property="Padding" Value="12,4,0,4" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <Style x:Key="DocumentHyperlinkStyle"
         TargetType="{x:Type Hyperlink}">
    <Setter Property="Foreground"
            Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  DOCUMENT VIEWERS                                          -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style TargetType="{x:Type FlowDocumentScrollViewer}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsToolBarVisible" Value="False" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style TargetType="{x:Type FlowDocumentReader}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsFindEnabled" Value="True" />
    <Setter Property="IsPrintEnabled" Value="True" />
  </Style>

  <Style TargetType="{x:Type FlowDocumentPageViewer}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style TargetType="{x:Type DocumentViewer}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

</ResourceDictionary>