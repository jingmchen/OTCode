<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- BORDER UTILITY STYLES -->
  <Style x:Key="card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="panel" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style x:Key="separator" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="editorFrame" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style x:Key="statusBar" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource StatusBarBrush}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="TextElement.Foreground"
            Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="TextElement.FontSize" Value="12" />
  </Style>

  <Style x:Key="dropZone" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!--
    Apply while a valid drag item is over the target:
    Style="{DynamicResource drop-ok}".
  -->
  <Style x:Key="drop-ok"
         TargetType="{x:Type Border}"
         BasedOn="{StaticResource dropZone}">
    <Setter Property="Background" Value="#3343A047" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessBrush}" />
  </Style>

  <!-- GRIDSPLITTER -->
  <Style TargetType="{x:Type GridSplitter}">
    <Setter Property="Background" Value="#10808080" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentLight1Brush}" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- EXPANDER -->
  <ControlTemplate x:Key="RoundedExpanderTemplate"
                   TargetType="{x:Type Expander}">
    <Border x:Name="ExpanderBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6"
            SnapsToDevicePixels="True">
      <DockPanel>
        <ToggleButton x:Name="HeaderToggle"
                      DockPanel.Dock="Top"
                      Padding="10,7"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{TemplateBinding Foreground}"
                      HorizontalContentAlignment="Stretch"
                      IsChecked="{Binding IsExpanded,
                                          RelativeSource={RelativeSource TemplatedParent},
                                          Mode=TwoWay}"
                      Content="{TemplateBinding Header}"
                      ContentTemplate="{TemplateBinding HeaderTemplate}">
          <ToggleButton.Template>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border x:Name="HeaderBackground"
                      Padding="{TemplateBinding Padding}"
                      Background="{TemplateBinding Background}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Path Width="6"
                        Height="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Data="M 0,0 L 6,5 L 0,10 Z"
                        Fill="{TemplateBinding Foreground}"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                      <RotateTransform x:Name="ArrowTransform" Angle="0" />
                    </Path.RenderTransform>
                  </Path>
                  <ContentPresenter Grid.Column="1"
                                    ContentSource="Content"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="HeaderBackground"
                          Property="Background"
                          Value="{DynamicResource ThemeHoverBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="ArrowTransform"
                          Property="Angle"
                          Value="90" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="ExpandSite"
                          Margin="10,4,10,10"
                          Visibility="Collapsed"
                          ContentSource="Content" />
      </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True">
        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ExpanderBorder" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type Expander}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template" Value="{StaticResource RoundedExpanderTemplate}" />
  </Style>

  <!-- SCROLLBAR -->
  <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="ThumbBorder"
                  Margin="2"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder"
                      Property="Background"
                      Value="{DynamicResource ThemeBorderStrongBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder"
                      Property="Background"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBarPageButtonStyle"
         TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBarDecreasePageButtonStyle"
         TargetType="{x:Type RepeatButton}"
         BasedOn="{StaticResource ScrollBarPageButtonStyle}">
    <Setter Property="Command" Value="{x:Static ScrollBar.PageUpCommand}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Orientation,
                                     RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                   Value="Horizontal">
        <Setter Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ScrollBarIncreasePageButtonStyle"
         TargetType="{x:Type RepeatButton}"
         BasedOn="{StaticResource ScrollBarPageButtonStyle}">
    <Setter Property="Command" Value="{x:Static ScrollBar.PageDownCommand}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Orientation,
                                     RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                   Value="Horizontal">
        <Setter Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate x:Key="ModernScrollBarTemplate"
                   TargetType="{x:Type ScrollBar}">
    <Grid x:Name="ScrollBarRoot"
          Width="12"
          Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track"
             Margin="0"
             Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}"
             Value="{Binding Value,
                             RelativeSource={RelativeSource TemplatedParent},
                             Mode=TwoWay}"
             ViewportSize="{TemplateBinding ViewportSize}"
             Orientation="{TemplateBinding Orientation}"
             IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarDecreasePageButtonStyle}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarIncreasePageButtonStyle}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter TargetName="ScrollBarRoot" Property="Width" Value="Auto" />
        <Setter TargetName="ScrollBarRoot" Property="Height" Value="12" />
        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ScrollBarRoot" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource ModernScrollBarTemplate}" />
  </Style>

  <!-- PROGRESSBAR -->
  <ControlTemplate x:Key="RoundedProgressBarTemplate"
                   TargetType="{x:Type ProgressBar}">
    <Grid x:Name="PART_Track"
          MinHeight="{TemplateBinding MinHeight}"
          ClipToBounds="True">
      <Border Background="{TemplateBinding Background}"
              CornerRadius="3" />
      <Border x:Name="PART_Indicator"
              HorizontalAlignment="Left"
              Background="{TemplateBinding Foreground}"
              CornerRadius="3" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsIndeterminate" Value="True">
        <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.75" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type ProgressBar}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Template" Value="{StaticResource RoundedProgressBarTemplate}" />
  </Style>

  <!-- TOOLTIP -->
  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- CONTEXTMENU -->
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ScrollViewer CanContentScroll="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>