<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  SURFACES                                                   -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Main application background -->
  <Style x:Key="AppSurfaceStyle"
         TargetType="{x:Type Border}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />
    <Setter Property="TextElement.Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
  </Style>

  <!-- Raised panels, cards, headers, and dialogs -->
  <Style x:Key="PanelSurfaceStyle"
         TargetType="{x:Type Border}"
         BasedOn="{StaticResource AppSurfaceStyle}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness"
            Value="1" />
    <Setter Property="CornerRadius"
            Value="6" />
  </Style>

  <!-- Recessed toolbars and secondary regions. -->
  <Style x:Key="SubtleSurfaceStyle"
         TargetType="{x:Type Border}"
         BasedOn="{StaticResource AppSurfaceStyle}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg2Brush}" />
  </Style>

  <!-- Accent-colored surface with matching readable foreground -->
  <Style x:Key="AccentSurfaceStyle"
         TargetType="{x:Type Border}">
    <Setter Property="Background"
            Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource AccentDark1Brush}" />
    <Setter Property="TextElement.Foreground"
            Value="{DynamicResource AccentForegroundBrush}" />
  </Style>

  <!-- Status bar foundation -->
  <Style x:Key="DefaultStatusBarStyle"
         TargetType="{x:Type StatusBar}">
    <Setter Property="Background"
            Value="{DynamicResource StatusBarBrush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource AccentDark1Brush}" />
    <Setter Property="BorderThickness"
            Value="0,1,0,0" />
    <Setter Property="Padding"
            Value="8,2" />
  </Style>

  <Style TargetType="{x:Type StatusBar}"
         BasedOn="{StaticResource DefaultStatusBarStyle}" />
  <Style TargetType="{x:Type StatusBarItem}"
         BasedOn="{StaticResource InheritedForegroundControlStyle}">
    <Setter Property="Background"
            Value="Transparent" />
    <Setter Property="Padding"
            Value="6,2" />
  </Style>

</ResourceDictionary>