<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  DIALOG WINDOW                                              -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DialogWindowStyle"
         TargetType="{x:Type Window}"
         BasedOn="{StaticResource {x:Type Window}}">

    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />

    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />

    <Setter Property="MinWidth" Value="360" />

    <Setter Property="MaxWidth" Value="720" />

    <Setter Property="SizeToContent" Value="WidthAndHeight" />

    <Setter Property="ResizeMode" Value="NoResize" />

    <Setter Property="ShowInTaskbar" Value="False" />

    <Setter Property="Padding" Value="0" />

    <Setter Property="SnapsToDevicePixels" Value="True" />

    <Setter Property="UseLayoutRounding" Value="True" />
    
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  MODAL OVERLAY AND SURFACE                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DialogOverlayStyle"
         TargetType="{x:Type Border}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeOverlayBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Panel.ZIndex" Value="1000" />
  </Style>

  <Style x:Key="DialogSurfaceStyle"
         TargetType="{x:Type Border}">
    <Setter Property="MinWidth" Value="360" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush"
            Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="DialogDividerStyle"
         TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,20" />
    <Setter Property="Background"
            Value="{DynamicResource ThemeBorderBrush}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  DIALOG TYPOGRAPHY                                         -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DialogTitleStyle"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="DialogDescriptionStyle"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg2Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  DIALOG ACTIONS                                            -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="DialogFooterStyle"
         TargetType="{x:Type StackPanel}">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,24,0,0" />
  </Style>

  <Style x:Key="DialogButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource ThemedButtonStyle}">
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>

  <Style x:Key="DialogPrimaryButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>

</ResourceDictionary>