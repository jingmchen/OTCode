<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fonts="clr-namespace:OTCode.Core.Enums;assembly=OTCode.Core">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  APP FONTS                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- General UI with fall backs -->
  <FontFamily x:Key="{x:Static fonts:AppFont.SegoeUI}">
    Segoe UI,
    Arial
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.SegoeUIVariable}">
    Segoe UI Variable,
    Segoe UI,
    Arial
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Arial}">
    Arial,
    Segoe UI
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Calibri}">
    Calibri,
    Segoe UI
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Tahoma}">
    Tahoma,
    Segoe UI
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Verdana}">
    Verdana,
    Segoe UI
  </FontFamily>

  <!-- Monospace and coding fonts with fall backs -->
  <FontFamily x:Key="{x:Static fonts:AppFont.CascadiaCode}">
    Cascadia Code,
    Consolas,
    Courier New
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.CascadiaMono}">
    Cascadia Mono,
    Consolas,
    Courier New
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Consolas}">
    Consolas,
    Cascadia Mono,
    Courier New
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.CourierNew}">
    Courier New,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.LucidaConsole}">
    Lucida Console,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.DejaVuSansMono}">
    DejaVu Sans Mono,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.SourceCodePro}">
    Source Code Pro,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.JetBrainsMono}">
    JetBrains Mono,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.FiraCode}">
    Fira Code,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.IBMPlexMono}">
    IBM Plex Mono,
    Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.RobotoMono}">
    Roboto Mono,
    Consolas
  </FontFamily>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  APPLICATION WINDOW DEFAULTS                                -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style TargetType="{x:Type Window}">
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource {x:Static fonts:AppFont.SegoeUI}}" />
    <Setter Property="FontSize"
            Value="14" />
    <Setter Property="TextOptions.TextFormattingMode"
            Value="Display" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  TEXT FOUNDATIONS                                           -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Named foundation for all TextBlock roles -->
  <Style x:Key="DefaultTextBlockStyle"
         TargetType="{x:Type TextBlock}" />

  <!-- Applies the foundation automatically to unstyled TextBlock controls -->
  <Style TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}" />

  <!-- Selectable TextBlock with read-only body text -->
  <Style x:Key="SelectableTextBlock"
         TargetType="{x:Type TextBox}">
    <Setter Property="IsReadOnly"
            Value="True" />
    <Setter Property="AcceptsReturn"
            Value="True" />
    <Setter Property="TextWrapping"
            Value="Wrap" />
    <Setter Property="Background"
            Value="Transparent" />
    <Setter Property="BorderThickness"
            Value="0" />
    <Setter Property="Padding"
            Value="0" />
    <Setter Property="SelectionBrush"
            Value="{DynamicResource ThemeSelectedBrush}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  TYPOGRAPHY SCALE                                           -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="h1"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="32" />
    <Setter Property="FontWeight"
            Value="Bold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
  </Style>

  <Style x:Key="h2"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="24" />
    <Setter Property="FontWeight"
            Value="SemiBold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />
  </Style>

  <Style x:Key="h3"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="18" />
    <Setter Property="FontWeight"
            Value="SemiBold" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg1Brush}" />
  </Style>

  <Style x:Key="subtle"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg2Brush}" />
  </Style>

  <Style x:Key="caption"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="12" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg3Brush}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  APPLICATION-SPECIFIC TEXT ROLES                            -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Pane Header -->
  <Style x:Key="paneHeader"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontWeight"
            Value="SemiBold" />
    <Setter Property="FontSize"
            Value="11" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg2Brush}" />
    <Setter Property="Margin"
            Value="0,4,0,4" />
  </Style>

  <!-- Transparent controls inherit the semantic foreground from their nearest Window or Surface -->
  <Style x:Key="InheritedForegroundControlStyle"
       TargetType="{x:Type Control}">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="(TextElement.Foreground)"
                 RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type FrameworkElement}}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type UserControl}"
         BasedOn="{StaticResource InheritedForegroundControlStyle}" />

  <Style TargetType="{x:Type Label}"
         BasedOn="{StaticResource InheritedForegroundControlStyle}" />

  <Style TargetType="{x:Type GroupBox}"
         BasedOn="{StaticResource InheritedForegroundControlStyle}" />

  <Style TargetType="{x:Type Expander}"
         BasedOn="{StaticResource InheritedForegroundControlStyle}" />

  <!-- Status Text -->
  <Style x:Key="statusText"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="12" />
    <Setter Property="Opacity"
            Value="0.7" />
    <Setter Property="TextTrimming"
            Value="CharacterEllipsis" />
  </Style>

  <!-- Type Tag -->
  <Style x:Key="typeTag"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="11" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg2Brush}" />
  </Style>

  <!-- Column Header -->
  <Style x:Key="columnHeader"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize"
            Value="11" />
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg2Brush}" />
  </Style>

  <!-- Error Text -->
  <Style x:Key="errorText"
         TargetType="{x:Type TextBlock}"
         BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="Foreground"
            Value="{DynamicResource ThemeErrorBrush}" />
  </Style>

</ResourceDictionary>