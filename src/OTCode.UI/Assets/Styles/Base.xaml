<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fonts="clr-namespace:OTCode.Core.Enums;assembly=OTCode.Core">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  APPFONTS                                                   -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- UI fonts -->
  <FontFamily x:Key="{x:Static fonts:AppFont.SegoeUI}">
    Segoe UI, Arial
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.SegoeUIVariable}">
    Segoe UI Variable, Segoe UI, Arial
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Arial}">
    Arial, Segoe UI
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Calibri}">
    Calibri, Segoe UI
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Tahoma}">
    Tahoma, Segoe UI
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Verdana}">
    Verdana, Segoe UI
  </FontFamily>

  <!-- Monospace / coding fonts -->
  <FontFamily x:Key="{x:Static fonts:AppFont.CascadiaCode}">
    Cascadia Code, Consolas, Courier New
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.CascadiaMono}">
    Cascadia Mono, Consolas, Courier New
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.Consolas}">
    Consolas, Cascadia Mono, Courier New
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.CourierNew}">
    Courier New, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.LucidaConsole}">
    Lucida Console, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.DejaVuSansMono}">
    DejaVu Sans Mono, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.SourceCodePro}">
    Source Code Pro, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.JetBrainsMono}">
    JetBrains Mono, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.FiraCode}">
    Fira Code, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.IBMPlexMono}">
    IBM Plex Mono, Consolas
  </FontFamily>

  <FontFamily x:Key="{x:Static fonts:AppFont.RobotoMono}">
    Roboto Mono, Consolas
  </FontFamily>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  WINDOW                                                     -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <Style TargetType="{x:Type Window}">
  
    <Setter Property="Background"
            Value="{DynamicResource ThemeBg0Brush}" />

    <Setter Property="Foreground"
            Value="{DynamicResource ThemeFg0Brush}" />

    <Setter Property="FontFamily"
            Value="{DynamicResource {x:Static fonts:AppFont.SegoeUI}}" />

    <Setter Property="FontSize"
            Value="14" />

    <Setter Property="TextOptions.TextFormattingMode"
            Value="Display" />

  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  TEXTBLOCK                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  
  <Style x:Key="DefaultTextBlockStyle" TargetType="{x:Type TextBlock}" />
  <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}" />

  <!-- Read-only TextBox. -->
  <Style x:Key="SelectableTextBlock" TargetType="{x:Type TextBox}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelectedBrush}" />
  </Style>

  <!-- TYPOGRAPHY SCALE -->
  <Style x:Key="h1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
  </Style>

  <Style x:Key="h2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
  </Style>

  <Style x:Key="h3" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg1Brush}" />
  </Style>

  <Style x:Key="subtle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg2Brush}" />
  </Style>

  <Style x:Key="caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg3Brush}" />
  </Style>

  <!-- APP-SPECIFIC TEXT ROLES -->
  <Style x:Key="paneHeader" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg2Brush}" />
    <Setter Property="Margin" Value="0,4,0,4" />
  </Style>

  <Style x:Key="statusText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="typeTag" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg2Brush}" />
  </Style>

  <Style x:Key="columnHeader" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg2Brush}" />
  </Style>

  <Style x:Key="errorText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource ThemeErrorBrush}" />
  </Style>

</ResourceDictionary>