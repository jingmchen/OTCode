<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="ThemeBg0Brush" Color="#FFFDF5" />
  <SolidColorBrush x:Key="ThemeBg1Brush" Color="#FFF9E9" />
  <SolidColorBrush x:Key="ThemeBg2Brush" Color="#F8EFD9" />
  <SolidColorBrush x:Key="ThemeBg3Brush" Color="#F1E5C8" />

  <!-- Foregrounds -->
  <SolidColorBrush x:Key="ThemeFg0Brush" Color="#302A23" />
  <SolidColorBrush x:Key="ThemeFg1Brush" Color="#574C40" />
  <SolidColorBrush x:Key="ThemeFg2Brush" Color="#786B5B" />
  <SolidColorBrush x:Key="ThemeFg3Brush" Color="#9A8C79" />

  <!-- Borders -->
  <SolidColorBrush x:Key="ThemeBorderBrush"       Color="#E7DAC0" />
  <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="#D3C3A3" />

  <!-- Interaction fills -->
  <SolidColorBrush x:Key="ThemeHoverBrush"    Color="#F6EDD8" />
  <SolidColorBrush x:Key="ThemePressedBrush"  Color="#EDE0C4" />
  <SolidColorBrush x:Key="ThemeSelectedBrush" Color="#F3E3BF" />

  <!-- Status -->
  <SolidColorBrush x:Key="ThemeErrorBrush"   Color="#B84732" />
  <SolidColorBrush x:Key="ThemeWarningBrush" Color="#A66B16" />
  <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#34765B" />
  <SolidColorBrush x:Key="ThemeInfoBrush"    Color="#356E9F" />

  <!-- Overlay / scrim -->
  <SolidColorBrush x:Key="ThemeOverlayBrush" Color="#66000000" />
</ResourceDictionary>