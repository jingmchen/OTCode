<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fonts="clr-namespace:OTCode.Core.Enums;assembly=OTCode.Core"
        x:Class="OTCode.UI.Views.Dialogs.TermsDialog"
        Title="Terms and Conditions"
        Style="{StaticResource DialogWindowStyle}"
        FontFamily="{DynamicResource {x:Static fonts:AppFont.SegoeUIVariable}}"
        Width="680"
        Height="680"
        MinWidth="540"
        MinHeight="460"
        Background="{DynamicResource ThemeBg0Brush}"
        WindowStartupLocation="CenterScreen">

  <Border Style="{StaticResource PanelSurfaceStyle}"
          Margin="16"
          Padding="20">

    <DockPanel>

      <!-- Header -->
      <StackPanel DockPanel.Dock="Top"
                  Margin="0,0,0,16">

        <TextBlock Style="{StaticResource DialogTitleStyle}"
                   Text="Terms and Conditions" />
        
        <TextBlock Style="{StaticResource DialogDescriptionStyle}"
                   Text="Please review the terms below. Accepting them is required to use the app." />
      
      </StackPanel>

      <!-- Actions -->
      <StackPanel DockPanel.Dock="Bottom"
                  Style="{StaticResource DialogFooterStyle}"
                  Margin="0,16,0,0">

        <Button Content="Decline"
                Style="{StaticResource DialogButtonStyle}"
                Margin="0"
                IsCancel="True"
                Click="OnDecline" />
        
        <Button x:Name="AcceptButton"
                Content="Accept"
                Style="{StaticResource DialogPrimaryButtonStyle}"
                IsDefault="True"
                IsEnabled="False"
                ToolTip="Scroll to the end of the terms to accept"
                ToolTipService.ShowOnDisabled="True"
                Click="OnAccept" />
        
      </StackPanel>

      <!-- Terms document -->
      <Border Style="{StaticResource EditorFrameStyle}">

        <FlowDocumentScrollViewer x:Name="TermsViewer"
                                  FontFamily="{DynamicResource {x:Static fonts:AppFont.SegoeUIVariable}}"
                                  FontSize="14"
                                  TextOptions.TextFormattingMode="Ideal"
                                  VerticalScrollBarVisibility="Auto" />
        
      </Border>
    </DockPanel>
  </Border>

</Window>